{
  "name": "@probadeck/showcase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter probadeck build && vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:sites",
    "preview": "vite preview",
    "sync:assets": "node scripts/sync-card-assets.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "probadeck": "workspace:*",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
