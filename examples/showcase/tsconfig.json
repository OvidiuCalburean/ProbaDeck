{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "rootDir": ".",
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.mjs",
    "browser/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.browser.config.ts",
    "vitest.config.ts"
  ]
}
