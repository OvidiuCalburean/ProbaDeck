{
  "name": "probadeck-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "ProbaDeck is a deterministic deck simulation and explainable probability engine for partially known card decks.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm build:core && pnpm build:showcase && pnpm build:infra",
    "build:core": "pnpm --filter probadeck build",
    "build:infra": "pnpm --filter @probadeck/aws-infra build",
    "build:showcase": "pnpm --filter @probadeck/showcase build",
    "check": "pnpm check:core && pnpm check:showcase && pnpm check:infra && pnpm test:browser && pnpm test:package",
    "check:core": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:types:minimum",
    "check:infra": "pnpm --filter @probadeck/aws-infra check",
    "check:showcase": "pnpm build:core && pnpm --filter @probadeck/showcase check",
    "dev:showcase": "pnpm --filter @probadeck/showcase dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm build:core && oxlint . --deny-warnings --report-unused-disable-directives",
    "pack:package": "node scripts/pack-package.mjs",
    "test": "pnpm --filter probadeck test",
    "test:browser": "pnpm build:core && pnpm --filter probadeck test:browser && pnpm --filter @probadeck/showcase test:browser",
    "test:lighthouse": "pnpm build:showcase && pnpm --filter @probadeck/showcase test:lighthouse",
    "test:package": "node scripts/package-smoke-test.mjs",
    "test:property": "pnpm --filter probadeck test:property",
    "test:stress": "node scripts/run-stress-tests.mjs",
    "test:coverage": "pnpm --filter probadeck test:coverage",
    "test:types:minimum": "node node_modules/typescript-5-0/lib/tsc.js -p packages/typescript/tsconfig.consumer.json",
    "typecheck": "pnpm --filter probadeck typecheck",
    "sync:showcase-assets": "pnpm --filter @probadeck/showcase sync:assets"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.17.1",
    "fast-check": "^4.9.0",
    "lighthouse": "13.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.55.0",
    "typescript": "^7.0.2",
    "typescript-5-0": "npm:typescript@5.0.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.24.0"
}
